  "laws": [
    {
      "id": "JP-2026-034",
      "officialRef": "内閣府令34/2026",
      "title": "食品表示基準 개정 — 카슈넛이 특정원재료가 됐다",
      "country": "JP",
      "category": "labeling",
      "itemCategories": [
        "food"
      ],
      "hsPrefixes": [
        "16",
        "17",
        "18",
        "19",
        "20",
        "21",
        "22"
      ],
      "sourceTier": "official",
      "status": "active",
      "riskLevel": "high",
      "effectiveDate": "2026-04-01",
      "deadline": "2028-03-31",
      "addedAt": "2026-09-06",
      "transitionEndsAt": "2028-03-31",
      "transitionNote": "알레르겐 표시 개정분은 2028.03.31까지 경과조치. 개별품목 표시규칙 개정분은 2030.03.31까지로 따로 간다",
      "changes": [
        {
          "before": "특정원재료(표시 의무) 8품목 — 새우·게·호두·밀·메밀·달걀·유·땅콩",
          "after": "카슈넛을 더해 9품목. 피스타치오는 특정원재료에 준하는 것(표시 권장)으로 추가돼 권장 20품목"
        },
        {
          "before": "개별품목별 표시규칙이 별표마다 흩어져 있었음",
          "after": "통조림·토마토가공품·농산물절임 등 42품목의 개별규정을 개정하거나 삭제해 횡단적 규칙으로 통일"
        },
        {
          "before": "냉동식품의 동결 전 가열 여부를 임의 위치에 표시",
          "after": "\"냉동식품\" 표시에 근접한 위치에 표시하도록 지정"
        }
      ],
      "affectedProductIds": [
        "p-kimchi-sauce",
        "p-seasoned-laver",
        "p-gochujang",
        "p-yuja"
      ],
